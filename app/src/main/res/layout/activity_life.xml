<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a"
    tools:context=".ui.LifeActivity">

    <!-- الخلفية الحية -->
    <View
        android:id="@+id/emotionalBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1a2e" />

    <!-- لوحة الخيال المشتركة -->
    <ImageView
        android:id="@+id/displayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="لوحة الخيال" />

    <!-- طبقة الأفكار الداخلية (تظهر فوق الصورة في الأعلى) -->
    <TextView
        android:id="@+id/thoughtsTextView"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="top"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="16dp"
        android:background="#AA000000"
        android:textColor="#88FFAA"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:visibility="invisible" />

    <!-- طبقة المحادثة (تظهر فوق الصورة في الأسفل) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#AA000000">

        <!-- عرض المحادثة باستخدام ListView -->
        <ListView
            android:id="@+id/chatListView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll"
            android:background="#55000000" />

        <!-- صف الإدخال والإرسال -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="اكتب رسالتك..."
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF"
                android:background="#44000000"
                android:padding="8dp"
                android:maxLines="3" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إرسال"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF5722"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- سجل الأحداث الداخلية (فوق الأفكار) -->
    <TextView
        android:id="@+id/eventLogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        android:background="#88000000"
        android:textColor="#00FF00"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:text="" />

    <!-- دليل المستخدم -->
    <TextView
        android:id="@+id/guideText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:text="المس الشاشة • تحدث معي • حرك الهاتف"
        android:textColor="#44ffffff"
        android:textSize="11sp"
        android:fontFamily="sans-serif-light" />

    <!-- حالة الوعي (رفعها فوق شريط المحادثة) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="200dp"
        android:layout_marginHorizontal="20dp"
        android:textColor="#88ffffff"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:shadowColor="#000"
        android:shadowRadius="3" />

</FrameLayout>
