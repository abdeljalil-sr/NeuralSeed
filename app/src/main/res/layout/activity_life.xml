<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a"
    tools:context=".ui.LifeActivity">

    <!-- الخلفية الحية -->
    <View
        android:id="@+id/emotionalBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1a2e" />

    <!-- لوحة الخيال المشتركة -->
    <ImageView
        android:id="@+id/displayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="لوحة الخيال" />

    <!-- ✅ سجل الأحداث الداخلية - أعلى الشاشة -->
    <TextView
        android:id="@+id/eventLogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        android:background="#88000000"
        android:textColor="#00FF00"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:text="" />

    <!-- حالة الوعي -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:layout_marginHorizontal="20dp"
        android:textColor="#88ffffff"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:shadowColor="#000"
        android:shadowRadius="3" />

    <!-- دليل المستخدم -->
    <TextView
        android:id="@+id/guideText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="50dp"
        android:text="المس الشاشة • تحدث معي • حرك الهاتف"
        android:textColor="#44ffffff"
        android:textSize="11sp"
        android:fontFamily="sans-serif-light" />

</FrameLayout>
