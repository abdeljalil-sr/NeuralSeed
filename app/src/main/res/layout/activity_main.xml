<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <com.neuralseed.PulseView
        android:id="@+id/pulse_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/control_panel"/>

    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/control_panel"
        android:background="@android:color/transparent"/>

    <TextView
        android:id="@+id/emotional_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="😐 محايد"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#80000000"
        android:padding="10dp"/>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#0A0A0A"
            android:padding="8dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/consciousness_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="[سجل الوعي...]\n"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/awaken_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إيقاظ"
                android:layout_marginEnd="10dp"/>

            <ImageButton
                android:id="@+id/voice_button"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"/>

            <Button
                android:id="@+id/sleep_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تنويم"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
